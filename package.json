{
  "name": "just-eat-for-business-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:content\"",
    "dev:main": "vite build --watch --mode development",
    "dev:content": "vite build --config vite.config.content.ts --watch --mode development",
    "build": "tsc -b && vite build && vite build --config vite.config.content.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "@tailwindcss/vite": "^4.1.17",
    "pino": "^9.4.0",
    "solid-js": "^1.9.10",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "chrome-types": "^0.1.389",
    "concurrently": "^9.1.2",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.2.2",
    "vite-plugin-solid": "^2.11.10",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
